# Cria um .gitignore amplo para projetos Python
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Ambientes virtuais
venv/
.venv/
env/
ENV/

# Variáveis de ambiente
.env
.env.*

# Distribuição e empacotamento
build/
dist/
*.egg-info/
.eggs/

# Testes e cobertura
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# Logs
*.log

# Arquivos temporários
*.tmp
*.temp
*.bak
*.swp

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
"@ | Set-Content .gitignore